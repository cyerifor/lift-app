# Supabase transaction pooler URL used by the Vercel runtime. Keep pgbouncer=true
# and a small connection limit for serverless concurrency.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct database URL used only by Prisma migrate/administration.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated additional origins when preview deployments need them.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
