generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  COACH
  ATHLETE
  ADMIN
}

enum DisplayUnits {
  METRIC
  IMPERIAL
}

enum BlockStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SessionStatus {
  PLANNED
  COMPLETED
  MISSED
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

enum FeedbackType {
  SESSION
  BLOCK
  GENERAL
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ExerciseMainLift {
  SQUAT
  BENCH
  DEADLIFT
  ACCESSORY
}

enum ExerciseCapability {
  LOADED_REPS
  BODYWEIGHT_REPS
  WEIGHTED_BODYWEIGHT
  TIME
}

enum ExerciseMode {
  PERCENT_E1RM
  REP_TARGET
  DOUBLE_PROGRESSION
}

enum ProgressionEligibility {
  YES
  NO
  OPTIONAL
}

enum ExerciseSource {
  SEEDED
  CUSTOM
  IMPORTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  role          Role     @default(ATHLETE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coachProfile      Coach?
  athleteProfile    Athlete?
  settings          UserSettings?
  sessions          SessionAccount[]
  accounts          Account[]
  startingStrengths StartingStrength[]

  @@index([role])
}

model SessionAccount {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("AuthSession")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserSettings {
  id                          String       @id @default(cuid())
  userId                      String       @unique
  displayName                 String?
  displayUnits                DisplayUnits @default(METRIC)
  bodyweightKg                Float?
  defaultLoadStepKg           Float?       @default(2.5)
  timezone                    String?
  readinessEnabled            Boolean      @default(true)
  sessionsPerWeek             Int          @default(3)
  trainingDays                String[]     @default([])
  prepFocusAreas              String[]     @default([])
  prepBudgetMinutes           Int          @default(10)
  squatReferenceExerciseId    String?
  benchReferenceExerciseId    String?
  deadliftReferenceExerciseId String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  user                        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  squatReferenceExercise      Exercise?    @relation("SquatReference", fields: [squatReferenceExerciseId], references: [id], onDelete: SetNull)
  benchReferenceExercise      Exercise?    @relation("BenchReference", fields: [benchReferenceExerciseId], references: [id], onDelete: SetNull)
  deadliftReferenceExercise   Exercise?    @relation("DeadliftReference", fields: [deadliftReferenceExerciseId], references: [id], onDelete: SetNull)

  @@index([squatReferenceExerciseId])
  @@index([benchReferenceExerciseId])
  @@index([deadliftReferenceExerciseId])
}

model StartingStrength {
  id               String           @id @default(cuid())
  userId           String
  parentLift       ExerciseMainLift
  loadKg           Float
  reps             Int
  rpe              Float
  calculatedE1rmKg Float
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, parentLift])
  @@index([userId])
}

model Coach {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  specialty String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  athletes     Athlete[]
  blocks       Block[]
  feedbacks    Feedback[]
  sessionLogs  SessionLog[]
  mediaAssets  MediaAsset[]
  analytics    Analytics[]
  inviteTokens InviteToken[]
}

model Athlete {
  id          String    @id @default(cuid())
  userId      String    @unique
  coachId     String?
  dateOfBirth DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach        Coach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  blocks       Block[]
  sessionLogs  SessionLog[]
  feedbacks    Feedback[]
  mediaAssets  MediaAsset[]
  analytics    Analytics[]
  inviteTokens InviteToken[]
  exercises    Exercise[]

  @@index([coachId])
}

model Block {
  id              String      @id @default(cuid())
  coachId         String
  athleteId       String
  title           String
  blockNumber     Int         @default(1)
  phase           String?     @default("Accumulation")
  weekCount       Int         @default(6)
  sessionsPerWeek Int         @default(4)
  config          String?
  goal            String?
  status          BlockStatus @default(DRAFT)
  startDate       DateTime
  endDate         DateTime
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  coach     Coach       @relation(fields: [coachId], references: [id], onDelete: Restrict)
  athlete   Athlete     @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  weeks     Week[]
  feedbacks Feedback[]
  analytics Analytics[]

  @@index([coachId])
  @@index([athleteId])
  @@index([startDate, endDate])
}

model Week {
  id         String   @id @default(cuid())
  blockId    String
  weekNumber Int
  startDate  DateTime
  endDate    DateTime
  objective  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  block    Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([blockId, weekNumber])
  @@index([blockId])
}

model Session {
  id            String        @id @default(cuid())
  weekId        String
  sessionNumber Int           @default(1)
  dayOfWeek     String?
  title         String
  scheduledAt   DateTime?
  status        SessionStatus @default(PLANNED)
  durationMin   Int?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  week      Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises ExerciseSlot[]
  logs      SessionLog[]
  feedbacks Feedback[]
  analytics Analytics[]

  @@unique([weekId, sessionNumber])
  @@index([weekId])
  @@index([scheduledAt])
}

model ExerciseSlot {
  id               String   @id @default(cuid())
  sessionId        String
  exerciseId       String?  @map("exerciseTemplateId")
  name             String
  exerciseType     String?  @default("Accessory")
  mainLift         String?  @default("accessory")
  category         String?
  progressionGroup String?  @default("accessory")
  targetSets       Int?     @default(3)
  repsDisplay      String?
  rpeDisplay       String?
  weeklyPercent    Float?
  roundingKg       Float?   @default(2.5)
  progEligible     Boolean  @default(true)
  orderIndex       Int
  instructions     String?
  tempo            String?
  restSec          Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session          Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise         Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  setPrescriptions SetPrescription[]
  setLogs          SetLog[]

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@index([exerciseId])
  @@map("Exercise")
}

model SetPrescription {
  id            String   @id @default(cuid())
  exerciseId    String
  setNumber     Int
  repsDisplay   String?
  rpeDisplay    String?
  suggestedLoKg Float?
  suggestedHiKg Float?
  reps          Int?
  targetRpe     Float?
  targetLoadKg  Float?
  targetPercent Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exercise ExerciseSlot @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, setNumber])
  @@index([exerciseId])
}

model Exercise {
  id                     String                 @id @default(cuid())
  athleteId              String
  legacyId               String?
  name                   String
  normalizedName         String
  mainLift               ExerciseMainLift
  category               String
  movementPattern        String?
  equipment              String?
  capability             ExerciseCapability
  defaultMode            ExerciseMode
  active                 Boolean                @default(true)
  parentLift             ExerciseMainLift?
  progressionGroup       String?
  progressionEligibility ProgressionEligibility @default(NO)
  loadStepKg             Float?
  tier                   Int                    @default(1)
  restText               String?
  seedRatio              Float?
  notes                  String?
  source                 ExerciseSource         @default(CUSTOM)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  athlete              Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  slots                ExerciseSlot[]
  squatReferenceFor    UserSettings[] @relation("SquatReference")
  benchReferenceFor    UserSettings[] @relation("BenchReference")
  deadliftReferenceFor UserSettings[] @relation("DeadliftReference")

  @@unique([athleteId, normalizedName])
  @@unique([athleteId, legacyId])
  @@index([athleteId, active])
  @@index([athleteId, mainLift, category])
  @@map("ExerciseTemplate")
}

model SessionLog {
  id                String   @id @default(cuid())
  athleteId         String
  sessionId         String
  coachReviewerId   String?
  completedAt       DateTime
  perceivedExertion Int?
  readinessScore    Int?
  bodyweightKg      Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  athlete       Athlete      @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  session       Session      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  coachReviewer Coach?       @relation(fields: [coachReviewerId], references: [id], onDelete: SetNull)
  setLogs       SetLog[]
  mediaAssets   MediaAsset[]
  feedbacks     Feedback[]
  analytics     Analytics[]

  @@unique([athleteId, sessionId, completedAt])
  @@index([athleteId])
  @@index([sessionId])
  @@index([coachReviewerId])
}

model SetLog {
  id            String   @id @default(cuid())
  sessionLogId  String
  exerciseId    String
  setNumber     Int
  repsCompleted Int?
  loadKg        Float?
  rpe           Float?
  velocityMps   Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessionLog SessionLog   @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  exercise   ExerciseSlot @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionLogId, exerciseId, setNumber])
  @@index([sessionLogId])
  @@index([exerciseId])
}

model Feedback {
  id           String       @id @default(cuid())
  coachId      String
  athleteId    String
  blockId      String?
  sessionId    String?
  sessionLogId String?
  type         FeedbackType @default(GENERAL)
  rating       Int?
  message      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  coach      Coach       @relation(fields: [coachId], references: [id], onDelete: Restrict)
  athlete    Athlete     @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  block      Block?      @relation(fields: [blockId], references: [id], onDelete: SetNull)
  session    Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionLog SessionLog? @relation(fields: [sessionLogId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([athleteId])
  @@index([blockId])
  @@index([sessionId])
  @@index([sessionLogId])
}

model MediaAsset {
  id           String    @id @default(cuid())
  coachId      String?
  athleteId    String?
  sessionLogId String?
  type         MediaType @default(IMAGE)
  url          String
  filename     String?
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  coach      Coach?      @relation(fields: [coachId], references: [id], onDelete: SetNull)
  athlete    Athlete?    @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  sessionLog SessionLog? @relation(fields: [sessionLogId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([athleteId])
  @@index([sessionLogId])
}

model Analytics {
  id           String   @id @default(cuid())
  coachId      String?
  athleteId    String?
  blockId      String?
  sessionId    String?
  sessionLogId String?
  metricKey    String
  metricValue  Float
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  coach      Coach?      @relation(fields: [coachId], references: [id], onDelete: SetNull)
  athlete    Athlete?    @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  block      Block?      @relation(fields: [blockId], references: [id], onDelete: SetNull)
  session    Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionLog SessionLog? @relation(fields: [sessionLogId], references: [id], onDelete: SetNull)

  @@index([metricKey, recordedAt])
  @@index([coachId])
  @@index([athleteId])
  @@index([blockId])
  @@index([sessionId])
  @@index([sessionLogId])
}

model InviteToken {
  id              String       @id @default(cuid())
  coachId         String
  athleteId       String?
  email           String?
  token           String       @unique
  sendInviteEmail Boolean      @default(false)
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  coach   Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athlete Athlete? @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([email])
  @@index([athleteId])
}
